# Free Gemini API Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Instant Free Pixabay API Key (get instantly at https://pixabay.com/api/docs/)
# If Pexels has paused new API keys, Pixabay issues free keys immediately upon signup!
# PIXABAY_API_KEY=your_pixabay_api_key_here

# Optional: Pexels API Key (if you already have one from https://www.pexels.com/api/)
# PEXELS_API_KEY=your_pexels_api_key_here

# Optional: TikTok Content Posting API credentials (from https://developers.tiktok.com/)
# TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
# TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Note: Even if you don't set any video API key, the pipeline automatically:
# 1. Searches free Wikimedia Commons video archives (zero key needed)
# 2. Generates sleek dark aesthetic vertical motion backgrounds with FFmpeg
# So video rendering works 100% out of the box with zero external keys!

# Optional: customize Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
